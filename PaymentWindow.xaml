<Window x:Class="ParkingSystem.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment" Height="580" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0A0E1A" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PayMethodBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfirmBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="0,14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="PAYMENT" FontSize="24" FontWeight="Black"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Select payment method" FontSize="12"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Receipt Info -->
        <Border Grid.Row="1" Background="#0D1228" CornerRadius="14" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SlotLabel"  Text="Slot: —"      Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="PlateLabel" Text="Plate: —"     Foreground="White"   FontSize="13" FontWeight="SemiBold" Margin="0,4,0,4"/>
                    <TextBlock x:Name="OwnerLabel" Text="Owner: —"     Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="TypeLabel"  Text="Type: —"      Foreground="White" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="CheckInLabel" Text="In: —"      Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="DurLabel"     Text="Duration: —" Foreground="White" FontSize="12" Margin="0,4,0,4"/>
                    <TextBlock Text="TOTAL FEE" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="FeeLabel" Text="0円"
                               FontSize="28" FontWeight="Black" Foreground="#00FF88"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Payment Method -->
        <TextBlock Grid.Row="2" Text="PAYMENT METHOD" FontSize="9" Foreground="White"
                   FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cash -->
            <Button x:Name="BtnCash" Grid.Column="0" Style="{StaticResource PayMethodBtn}"
                    Margin="0,0,8,0" Height="130" Click="SelectCash"
                    Background="#0D1228" BorderBrush="#2A3060" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="52" Height="52" Margin="0,0,0,8">
                        <Canvas Width="52" Height="52">
                            <Rectangle Width="48" Height="30" Canvas.Left="2" Canvas.Top="11" Fill="#1A3A1A" RadiusX="5" RadiusY="5"/>
                            <Rectangle Width="48" Height="30" Canvas.Left="2" Canvas.Top="11" Stroke="#00FF88" StrokeThickness="2" Fill="Transparent" RadiusX="5" RadiusY="5"/>
                            <Ellipse Width="16" Height="16" Canvas.Left="18" Canvas.Top="18" Fill="#00FF88" Opacity="0.3"/>
                            <Ellipse Width="16" Height="16" Canvas.Left="18" Canvas.Top="18" Stroke="#00FF88" StrokeThickness="1.5" Fill="Transparent"/>
                            <TextBlock Canvas.Left="22" Canvas.Top="18" Text="$" FontSize="10" FontWeight="Black" Foreground="#00FF88"/>
                            <Rectangle Width="6" Height="2" Canvas.Left="4" Canvas.Top="13" Fill="#00FF88" Opacity="0.5" RadiusX="1" RadiusY="1"/>
                            <Rectangle Width="6" Height="2" Canvas.Left="4" Canvas.Top="37" Fill="#00FF88" Opacity="0.5" RadiusX="1" RadiusY="1"/>
                            <Rectangle Width="6" Height="2" Canvas.Left="42" Canvas.Top="13" Fill="#00FF88" Opacity="0.5" RadiusX="1" RadiusY="1"/>
                            <Rectangle Width="6" Height="2" Canvas.Left="42" Canvas.Top="37" Fill="#00FF88" Opacity="0.5" RadiusX="1" RadiusY="1"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="CASH" FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Physical money" FontSize="10" Foreground="#3A4466" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>

            <!-- Credit Card -->
            <Button x:Name="BtnCard" Grid.Column="1" Style="{StaticResource PayMethodBtn}"
                    Margin="0,0,8,0" Height="130" Click="SelectCard"
                    Background="#0D1228" BorderBrush="#2A3060" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="52" Height="52" Margin="0,0,0,8">
                        <Canvas Width="52" Height="52">
                            <Rectangle Width="46" Height="32" Canvas.Left="3" Canvas.Top="10" Fill="#1A1A3A" RadiusX="5" RadiusY="5"/>
                            <Rectangle Width="46" Height="32" Canvas.Left="3" Canvas.Top="10" Stroke="#8B5CF6" StrokeThickness="2" Fill="Transparent" RadiusX="5" RadiusY="5"/>
                            <Rectangle Width="46" Height="8" Canvas.Left="3" Canvas.Top="17" Fill="#8B5CF6" Opacity="0.7"/>
                            <Rectangle Width="16" Height="5" Canvas.Left="7" Canvas.Top="29" Fill="#8B5CF6" Opacity="0.5" RadiusX="2" RadiusY="2"/>
                            <Ellipse Width="10" Height="10" Canvas.Left="35" Canvas.Top="27" Fill="#FFD700" Opacity="0.8"/>
                            <Ellipse Width="10" Height="10" Canvas.Left="40" Canvas.Top="27" Fill="#FFD700" Opacity="0.5"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="CREDIT CARD" FontSize="13" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Visa / Mastercard" FontSize="10" Foreground="#3A4466" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>

            <!-- QR Pay -->
            <Button x:Name="BtnQR" Grid.Column="2" Style="{StaticResource PayMethodBtn}"
                    Height="130" Click="SelectQR"
                    Background="#0D1228" BorderBrush="#2A3060" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="52" Height="52" Margin="0,0,0,8">
                        <Canvas Width="52" Height="52">
                            <!-- QR pattern -->
                            <Rectangle Width="18" Height="18" Canvas.Left="4" Canvas.Top="4" Stroke="#00D4FF" StrokeThickness="2" Fill="Transparent"/>
                            <Rectangle Width="10" Height="10" Canvas.Left="8" Canvas.Top="8" Fill="#00D4FF"/>
                            <Rectangle Width="18" Height="18" Canvas.Left="30" Canvas.Top="4" Stroke="#00D4FF" StrokeThickness="2" Fill="Transparent"/>
                            <Rectangle Width="10" Height="10" Canvas.Left="34" Canvas.Top="8" Fill="#00D4FF"/>
                            <Rectangle Width="18" Height="18" Canvas.Left="4" Canvas.Top="30" Stroke="#00D4FF" StrokeThickness="2" Fill="Transparent"/>
                            <Rectangle Width="10" Height="10" Canvas.Left="8" Canvas.Top="34" Fill="#00D4FF"/>
                            <Rectangle Width="4" Height="4" Canvas.Left="30" Canvas.Top="30" Fill="#00D4FF"/>
                            <Rectangle Width="4" Height="4" Canvas.Left="36" Canvas.Top="30" Fill="#00D4FF"/>
                            <Rectangle Width="4" Height="4" Canvas.Left="42" Canvas.Top="30" Fill="#00D4FF"/>
                            <Rectangle Width="4" Height="4" Canvas.Left="30" Canvas.Top="36" Fill="#00D4FF"/>
                            <Rectangle Width="4" Height="4" Canvas.Left="42" Canvas.Top="36" Fill="#00D4FF"/>
                            <Rectangle Width="4" Height="4" Canvas.Left="30" Canvas.Top="42" Fill="#00D4FF"/>
                            <Rectangle Width="4" Height="4" Canvas.Left="36" Canvas.Top="42" Fill="#00D4FF"/>
                            <Rectangle Width="4" Height="4" Canvas.Left="42" Canvas.Top="42" Fill="#00D4FF"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="PAY PAY QR" FontSize="13" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Scan &amp; Pay" FontSize="10" Foreground="#3A4466" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Confirm / Cancel -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnConfirm" Style="{StaticResource ConfirmBtn}"
                    Background="#00FF88" Click="BtnConfirm_Click">
                <TextBlock Text="CONFIRM PAYMENT" FontSize="14" FontWeight="Black" Foreground="#0A0E1A"/>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ConfirmBtn}"
                    Background="#1A2040" Click="BtnCancelPay_Click">
                <TextBlock Text="CANCEL" FontSize="14" FontWeight="Bold" Foreground="White"/>
            </Button>
        </Grid>
    </Grid>
</Window>
