<Window x:Class="ParkingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Parking System" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E1A" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SideVehicleBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A1F35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#2A3060"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlotBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="18,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTB" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1F35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A3060"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CaretBrush" Value="#00D4FF"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>


        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0D1228" BorderBrush="#1A2040" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="0,28,0,18" HorizontalAlignment="Center">
                    <Viewbox Width="88" Height="88">
                        <Canvas Width="88" Height="88">
                            <Ellipse Width="88" Height="88" Fill="#00D4FF" Opacity="0.12"/>
                            <Ellipse Width="88" Height="88" Stroke="#00D4FF" StrokeThickness="3" Fill="Transparent"/>
                            <Ellipse Width="68" Height="68" Canvas.Left="10" Canvas.Top="10"
                                     Stroke="#00D4FF" StrokeThickness="1" Fill="Transparent" Opacity="0.4"/>
                            <TextBlock Canvas.Left="22" Canvas.Top="12" Text="P"
                                       FontSize="52" FontWeight="Black" Foreground="#00D4FF"/>
                            <Rectangle Canvas.Left="30" Canvas.Top="70" Width="28" Height="3"
                                       Fill="#00D4FF" RadiusX="2" RadiusY="2" Opacity="0.5"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="SMART PARKING" HorizontalAlignment="Center"
                               FontSize="14" FontWeight="Black" Foreground="#00D4FF" Margin="0,8,0,0"/>
                    <TextBlock Text="MANAGEMENT SYSTEM" HorizontalAlignment="Center"
                               FontSize="8" Foreground="White" Margin="0,3,0,0"/>
                </StackPanel>

                <Rectangle Grid.Row="1" Height="1" Fill="#1A2040" Margin="20,0"/>

                <!-- Vehicle Buttons -->
                <StackPanel Grid.Row="2" Margin="18,22,18,0">
                    <TextBlock Text="SELECT VEHICLE" FontSize="9" Foreground="White"
                               Margin="0,0,0,12" FontWeight="Bold"/>

                    <Button x:Name="BtnCar" Style="{StaticResource SideVehicleBtn}"
                            Height="82" Margin="0,0,0,10" Click="BtnCar_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="50" Height="32" Margin="0,0,10,0">
                                <Canvas Width="50" Height="32">
                                    <Rectangle Canvas.Left="2" Canvas.Top="12" Width="46" Height="16" Fill="#00D4FF" RadiusX="4" RadiusY="4"/>
                                    <Path Fill="#00A8CC" Data="M10,12 L15,3 L35,3 L40,12 Z"/>
                                    <Rectangle Canvas.Left="16" Canvas.Top="5" Width="7" Height="7" Fill="#0A0E1A" RadiusX="1" RadiusY="1"/>
                                    <Rectangle Canvas.Left="25" Canvas.Top="5" Width="8" Height="7" Fill="#0A0E1A" RadiusX="1" RadiusY="1"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="22" Width="11" Height="11" Fill="#0A0E1A" Stroke="#00D4FF" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="32" Canvas.Top="22" Width="11" Height="11" Fill="#0A0E1A" Stroke="#00D4FF" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="42" Canvas.Top="16" Width="6" Height="4" Fill="#FFD700"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CAR" FontSize="17" FontWeight="Black" Foreground="White"/>
                                <TextBlock x:Name="CarSlotInfo" Text="10 Slots" FontSize="10" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnBike" Style="{StaticResource SideVehicleBtn}"
                            Height="82" Margin="0,0,0,10" Click="BtnBike_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="50" Height="38" Margin="0,0,10,0">
                                <Canvas Width="50" Height="38">
                                    <Ellipse Canvas.Left="2" Canvas.Top="18" Width="18" Height="18" Stroke="#FF6B6B" StrokeThickness="3" Fill="Transparent"/>
                                    <Ellipse Canvas.Left="30" Canvas.Top="18" Width="18" Height="18" Stroke="#FF6B6B" StrokeThickness="3" Fill="Transparent"/>
                                    <Line X1="11" Y1="27" X2="25" Y2="10" Stroke="#FF6B6B" StrokeThickness="2.5"/>
                                    <Line X1="25" Y1="10" X2="39" Y2="27" Stroke="#FF6B6B" StrokeThickness="2.5"/>
                                    <Line X1="11" Y1="27" X2="39" Y2="27" Stroke="#FF6B6B" StrokeThickness="2"/>
                                    <Line X1="32" Y1="10" X2="44" Y2="10" Stroke="#FF6B6B" StrokeThickness="2.5"/>
                                    <Line X1="39" Y1="8" X2="39" Y2="14" Stroke="#FF6B6B" StrokeThickness="2"/>
                                    <Line X1="19" Y1="10" X2="28" Y2="10" Stroke="#FF6B6B" StrokeThickness="3"/>
                                    <Ellipse Canvas.Left="21" Canvas.Top="23" Width="8" Height="8" Fill="#FF6B6B" Opacity="0.7"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BICYCLE" FontSize="17" FontWeight="Black" Foreground="White"/>
                                <TextBlock x:Name="BikeSlotInfo" Text="10 Slots" FontSize="10" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMotor" Style="{StaticResource SideVehicleBtn}"
                            Height="82" Margin="0,0,0,10" Click="BtnMotor_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="50" Height="36" Margin="0,0,10,0">
                                <Canvas Width="50" Height="36">
                                    <Ellipse Canvas.Left="1" Canvas.Top="18" Width="16" Height="16" Stroke="#FFB347" StrokeThickness="3" Fill="Transparent"/>
                                    <Ellipse Canvas.Left="33" Canvas.Top="18" Width="16" Height="16" Stroke="#FFB347" StrokeThickness="3" Fill="Transparent"/>
                                    <Path Fill="#FFB347" Data="M14,26 L18,14 L22,10 L30,10 L34,14 L34,26 Z"/>
                                    <Rectangle Canvas.Left="19" Canvas.Top="12" Width="10" Height="8" Fill="#E8932A" RadiusX="2" RadiusY="2"/>
                                    <Line X1="30" Y1="10" X2="44" Y2="8" Stroke="#FFB347" StrokeThickness="2.5"/>
                                    <Line X1="40" Y1="6" X2="40" Y2="13" Stroke="#FFB347" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="44" Canvas.Top="12" Width="5" Height="4" Fill="#FFD700"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MOTORBIKE" FontSize="15" FontWeight="Black" Foreground="White"/>
                                <TextBlock x:Name="MotorSlotInfo" Text="10 Slots" FontSize="10" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Stats -->
                <Border Grid.Row="3" Margin="18,0,18,22" Background="#0A0E1A" CornerRadius="12" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TotalActive" Text="0" FontSize="22" FontWeight="Black"
                                       Foreground="#00D4FF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Active" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Rectangle Grid.Column="0" Width="1" Fill="#1A2040" HorizontalAlignment="Right"/>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock x:Name="TotalRevenue" Text="円" FontSize="20" FontWeight="Black"
                                       Foreground="#00FF88" HorizontalAlignment="Center"/>
                            <TextBlock Text="Revenue" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="22,22,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,0,16"/>
                <Border Grid.Column="1" Background="#0D1228" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#00FF88" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClockText" Text="" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Content Panels -->
            <Grid Grid.Row="1">
                <!-- Welcome screen -->

                <!-- Welcome screen -->
                <Border x:Name="WelcomePanel"
        CornerRadius="20">

                    <Border.Resources>

                        <Storyboard x:Key="FloatingAnimation">

                            <DoubleAnimation
                Storyboard.TargetName="MoveEffect"
                Storyboard.TargetProperty="Y"
                From="-8"
                To="8"
               />

                        </Storyboard>

                    </Border.Resources>


                    <Border.Background>

                        <LinearGradientBrush
            StartPoint="0,0"
            EndPoint="1,1">

                            <GradientStop Color="#18203A" Offset="0"/>
                            <GradientStop Color="#0D1228" Offset="0.5"/>
                            <GradientStop Color="#090D18" Offset="1"/>

                        </LinearGradientBrush>

                    </Border.Background>


                    <Border.Triggers>

                        <EventTrigger RoutedEvent="Loaded">

                            <BeginStoryboard
                Storyboard="{StaticResource FloatingAnimation}"/>

                        </EventTrigger>

                    </Border.Triggers>
 

                    <Grid Margin="25">

                        <Grid.RenderTransform>

                            <TranslateTransform
                x:Name="MoveEffect"/>

                        </Grid.RenderTransform>


                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- Top Title -->

                        <StackPanel HorizontalAlignment="Center"/>

                        <Grid Grid.Row="1" Margin="0,15,0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CAR -->
                            <Border Grid.Row="0" Grid.Column="0"
            Background="#1D2746"
            CornerRadius="18"
            Padding="18"
            Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30"
                              ShadowDepth="0"
                              Color="#FFD700"
                              Opacity="0.8"/>
                                </Border.Effect>

                                <StackPanel>
                                    <TextBlock Text="🚗 DAY TIME (CAR)"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="#FFD700"/>
                                    <TextBlock Text="08:00 ~ 20:00 "
                       Margin="0,8,0,0"
                       Foreground="White"/>
                                    <TextBlock Text="30 Minutes"
                       Foreground="#AAAAAA"/>
                                    <Separator Margin="0,1"/>
                                    <TextBlock Text="¥200"
                       FontSize="26"
                       FontWeight="Black"
                       Foreground="#00FF88"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2"
            Background="#111A34"
            CornerRadius="18"
            Padding="18"
            Margin="0,0,0,12">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30"
                              ShadowDepth="0"
                              Color="#00D4FF"
                              Opacity="0.8"/>
                                </Border.Effect>

                                <StackPanel>
                                    <TextBlock Text="🌙 NIGHT TIME (CAR)"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="#00D4FF"/>
                                    <TextBlock Text="20:00 ~ 08:00"
                       Margin="0,8,0,0"
                       Foreground="White"/>
                                    <Separator Margin="0,1"/>
                                    <TextBlock Text="¥800"
                       FontSize="26"
                       FontWeight="Black"
                       Foreground="#8B5CF6"/>
                                </StackPanel>
                            </Border>


                            <!-- BIKE -->
                            <Border Grid.Row="1" Grid.Column="0"
            Background="#1D2746"
            CornerRadius="18"
            Padding="18"
            Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🚲 DAY TIME (BIKE)"
FontWeight="Bold"
FontSize="16"
Foreground="#FFD700"/>
                                    <TextBlock Text="08:00 ~ 20:00 "
Margin="0,8,0,0"
Foreground="White"/>
                                    <TextBlock Text="30 Minutes"
Foreground="#AAAAAA"/>
                                    <Separator Margin="0,1"/>
                                    <TextBlock Text="¥100"
FontSize="26"
FontWeight="Black"
Foreground="#00FF88"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2"
            Background="#111A34"
            CornerRadius="18"
            Padding="18"
            Margin="0,0,0,12">

                                <StackPanel>
                                    <TextBlock Text="🌙 NIGHT TIME (BIKE)"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="#00D4FF"/>
                                    <TextBlock Text="20:00 ~ 08:00"
                       Margin="0,8,0,0"
                       Foreground="White"/>
                                    <Separator Margin="0,1"/>
                                    <TextBlock Text="¥400"
                       FontSize="26"
                       FontWeight="Black"
                       Foreground="#8B5CF6"/>
                                </StackPanel>
                            </Border>


                            <!-- MOTOR -->
                            <Border Grid.Row="2" Grid.Column="0"
            Background="#1D2746"
            CornerRadius="18"
            Padding="18">

                                <StackPanel>
                                    <TextBlock Text="🏍 DAY TIME (MOTOR)"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="#FFD700"/>
                                    <TextBlock Text="08:00 ~ 20:00"
                       Margin="0,8,0,0"
                       Foreground="White"/>
                                    <TextBlock Text="30 Minutes"
                       Foreground="#AAAAAA"/>
                                    <Separator Margin="0,1"/>
                                    <TextBlock Text="¥150"
                       FontSize="26"
                       FontWeight="Black"
                       Foreground="#00FF88"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2"
            Background="#111A34"
            CornerRadius="18"
            Padding="18" Margin="0,10,0,70" Grid.RowSpan="2">

                                <StackPanel>
                                    <TextBlock Text="🌙 NIGHT TIME (MOTOR)"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="#00D4FF"/>
                                    <TextBlock Text="20:00 ~ 08:00"
                       Margin="0,8,0,0"
                       Foreground="White"/>
                                    <Separator Margin="0,1"/>
                                    <TextBlock Text="¥600"
FontSize="26"
FontWeight="Black"
Foreground="#8B5CF6"/>
                                </StackPanel>
                            </Border>

                            <Button Grid.Row="3"
        Grid.ColumnSpan="3"
        x:Name="BtnContinue"
        Content="Continue"
        Width="180"
        Height="45"
        Margin="0,25,0,0"
        Background="#00D4FF"
        Foreground="#0A0E1A"
        FontWeight="Bold"
        Click="BtnContinue_Click"/>

                        </Grid>
                        <!-- inner Grid Row=1 -->
                    </Grid>
                    <!-- Grid Margin=25 (missing) -->
                </Border>
                <!-- WelcomePanel -->
                <!-- Slot Layout Panel -->
                <Border x:Name="SlotPanel"
        Background="#0D1228"
        CornerRadius="16"
        Padding="20"
        Visibility="Collapsed">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Legend -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#1A3A1A" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="12" Height="12" Fill="#00FF88" RadiusX="3" RadiusY="3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Available" Foreground="#00FF88" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#3A1A1A" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="12" Height="12" Fill="#FF4444" RadiusX="3" RadiusY="3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Occupied" Foreground="#FF4444" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A2A3A" CornerRadius="6" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="12" Height="12" Fill="#00D4FF" RadiusX="3" RadiusY="3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Selected" Foreground="#00D4FF" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Slot Grid -->
                        <UniformGrid x:Name="SlotGrid" Grid.Row="1" Rows="2" Columns="5" Margin="0,0,0,16"/>

                        <!-- Register Form (hidden until slot selected) -->
                        <Border x:Name="RegisterForm" Grid.Row="2" Background="#0A0E1A"
                                CornerRadius="14" Padding="20,16" Visibility="Collapsed"
                                Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Background="#00D4FF" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                                        <TextBlock x:Name="SelectedSlotLabel" Text="C1"
                                                   FontSize="18" FontWeight="Black" Foreground="#0A0E1A"/>
                                    </Border>
                                    <TextBlock Text="Register Vehicle" FontSize="18" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Grid.Row="1" >

                                    <StackPanel Grid.Column="0" >
                                        <TextBlock Text="PLATE NUMBER" FontSize="11" Foreground="#00FF88" Margin="0,0,0,6" FontWeight="Bold"/>
                                        <TextBox x:Name="TxtPlate" Style="{StaticResource ModernTB}" Height="40" />
                                    </StackPanel>

                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionBtn}" Background="#00D4FF"
                                            Foreground="#0A0E1A" FontSize="13"
                                            Content="✔  CHECK IN" Height="42" Click="BtnCheckIn_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnCheckOutForm" Style="{StaticResource ActionBtn}"
                                            Background="#FF4444" Foreground="White" FontSize="13"
                                            Content="✕  CHECK OUT" Height="42" Click="BtnCheckOut_Click"
                                            Visibility="Collapsed"/>
                                    <Button Style="{StaticResource ActionBtn}" Background="#1A2040"
                                            Foreground="#FF4444" FontSize="13"
                                            Content="Cancel" Height="42" Click="BtnCancel_Click" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Message Bar -->
                        <Border x:Name="MsgBar" Grid.Row="3" CornerRadius="10" Padding="14,10"
                                Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="MsgText" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
